class Solution {
    public List<int> minAnd2ndMin(int[] arr) {
        // code here
       int firstmin;
       int secmin = int.MaxValue;
       if(arr.Length == 0 ){
           return new List<int>(){-1};
       }
       firstmin = arr[0];
       for(int i = 1; i<arr.Length;i++){
           if(arr[i]<secmin && arr[i]<firstmin){
               secmin = firstmin;
               firstmin = arr[i];
           }
           else if(arr[i]>firstmin && arr[i]<secmin){
               secmin = arr[i];
           }
       }
    if(secmin == int.MaxValue){
         return new List<int>(){-1};
    }
    return  new List<int>(){firstmin,secmin};
    
    }
}
