class Solution
{
    public List<int> minAnd2ndMin(int[] arr)
    {
        int firstMin = int.MaxValue;
        int secondMin = int.MaxValue;

        foreach (int num in arr)
        {
            if (num < firstMin)
            {
                secondMin = firstMin;
                firstMin = num;
            }
            else if (num > firstMin && num < secondMin)
            {
                secondMin = num;
            }
        }

        if (secondMin == int.MaxValue)
        {
            return new List<int> { -1 };
        }

        return new List<int> { firstMin, secondMin };
    }
}


