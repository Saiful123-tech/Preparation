            return 0;
        }
        Dictionary<int,bool> dict = new Dictionary<int,bool>();
        for(int i=0;i<nums.Length;i++){
            if(!dict.ContainsKey(nums[i])){
                dict[nums[i]] = true;
            }
        }
        int longest = 1;
        for(int j =0;j<nums.Length;j++){
          if(!dict.ContainsKey(nums[j] - 1)){
            int count  = 0;
            int value = nums[j];
            while(dict.ContainsKey(value)){
                 count++;
                 value = value + 1; 
            }
            if(longest<count){
                longest = count;
            }
          }  
        }
        return longest;
    }
}
