public class Solution {
     private bool AreEqual(
        Dictionary<char, int> dict1,
        Dictionary<char, int> dict2)
    {
        if (dict1.Count != dict2.Count)
            return false;

        foreach (var item in dict1)
        {
            if (!dict2.ContainsKey(item.Key))
                return false;

            if (dict1[item.Key] != dict2[item.Key])
                return false;
        }

        return true;
    }
    public IList<int> FindAnagrams(string s, string p) {
        Dictionary<char,int> sdict = new Dictionary<char,int>();
       Dictionary<char,int> pdict = new Dictionary<char,int>();

        if(s.Length<p.Length){
            return new List<int>();
        }
        for(int k=0;k<p.Length;k++){
            if(pdict.ContainsKey(p[k])){
                pdict[p[k]]++;
                continue;
            }
            pdict[p[k]] = 1;
        }
        int left = 0;
        int right = 0;
        IList<int> li = new List<int>();
        while(right<s.Length){
            char incoming = s[right];
            if(sdict.ContainsKey(incoming)){
                sdict[incoming]++;
            }
            else{
                 sdict[incoming] = 1;
            }

            if(right-left+1>p.Length){
                char outgoing = s[left];
                sdict[outgoing]--;
                if(sdict[outgoing]==0){
                    sdict.Remove(outgoing);
                }
                left++;
            }

            if(right-left + 1 == p.Length && AreEqual(pdict,sdict)){
                      li.Add(left);
            }
            right++;
        }
        return li;
    }
}

TC: o(n+m)
SC:  o(k)

